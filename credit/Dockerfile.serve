# Credit CSS FastAPI serving — loads pipeline.joblib and exposes /score + /drivers.
# Build from repo root:
#   docker build -f credit/Dockerfile.serve -t credit-css-serve .
# Run (mount the joblib from credit-css fit):
#   docker run --rm -p 8000:8000 \
#     -e CREDIT_PIPELINE_ARTIFACT=/artifact/pipeline.joblib \
#     -v /tmp/credit_artifact:/artifact:ro \
#     credit-css-serve

FROM python:3.11-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /uvx /bin/

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1

COPY pyproject.toml uv.lock README.md ./
COPY credit ./credit
COPY investing/pyproject.toml investing/pyproject.toml

RUN uv sync --frozen --no-dev --package credit --no-editable

ENV PATH="/app/.venv/bin:$PATH" \
    CREDIT_PIPELINE_ARTIFACT=/artifact/pipeline.joblib
EXPOSE 8000

# Factory loads artifact from CREDIT_PIPELINE_ARTIFACT at startup.
CMD ["uvicorn", "credit.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
